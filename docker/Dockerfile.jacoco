FROM maven:3.9-eclipse-temurin-21

WORKDIR /build

COPY pricing-api-contract/pom.xml pricing-api-contract/pom.xml

RUN mvn \
    -f pricing-api-contract/pom.xml \
    clean install \
    -DskipTests

COPY pricing-api-contract/target/classes/pricing-api/ \
     /build/pricing-api-contract/target/classes/pricing-api/

COPY pricing-service/pom.xml pricing-service/pom.xml
COPY pricing-service/src pricing-service/src

RUN mvn \
    -f pricing-service/pom.xml \
    clean \
    -DskipTests

RUN mkdir -p /build/pricing-service/target/contract/pricing-api \
    && cp -r /build/pricing-api-contract/target/classes/pricing-api/. \
       /build/pricing-service/target/contract/pricing-api/

RUN JACOCO_VERSION=$(mvn -q \
        -f pricing-service/pom.xml \
        help:evaluate \
        -Dexpression=jacoco.version \
        -DforceStdout) \
    && echo "JaCoCo version: ${JACOCO_VERSION}" \
    && mvn -q \
        -f pricing-service/pom.xml \
        dependency:get \
        -Dartifact=org.jacoco:org.jacoco.agent:${JACOCO_VERSION}:jar:runtime \
        -Dtransitive=false

WORKDIR /build/pricing-service

CMD ["sh", "-c", "JACOCO_AGENT=$(find /root/.m2/repository/org/jacoco/org.jacoco.agent -type f -name '*-runtime.jar' | head -1) && echo \"JaCoCo agent: ${JACOCO_AGENT}\" && mvn verify \"-DjacocoArgLine=-javaagent:${JACOCO_AGENT}=destfile=/build/pricing-service/target/jacoco.exec\""]